<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>CudaSharp.Test</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsPackable>false</IsPackable>
    <NoWarn>$(NoWarn);CA2007</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\CudaSharp\CudaSharp.csproj" />
  </ItemGroup>
  
  <ItemGroup>
    <AssemblyAttribute Include="System.Diagnostics.CodeAnalysis.ExcludeFromCodeCoverageAttribute" />
  </ItemGroup>
  
  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="10.0.1">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="MSTest" Version="4.2.3" />

    <PackageReference Include="NtvLibs.cuda13.nvrtc-builtins64_133.runtime.json" Version="13.3.0" />
    <PackageReference Include="NtvLibs.cuda13.nvrtc-builtins64_133.runtime.win-x64" Version="13.3.0" />
    <PackageReference Include="NtvLibs.cuda13.nvrtc64_130_0.runtime.json" Version="13.3.0" />
    <PackageReference Include="NtvLibs.cuda13.nvrtc64_130_0.runtime.win-x64" Version="13.3.0" />
  </ItemGroup>

</Project>
